@phdthesis{fielding2000rest,
      title={Architectural Styles and the Design of Network-based Software Architectures},
      author={Fielding, Roy Thomas},
      school={University of California, Irvine},
      year={2000},
      note={The style-extracted-from-a-working-instance precedent (§5.2: "Sigma is to the forge what REST was to HTTP"), and the register precedent for the whole paper. Cited for extraction and for the cacheability analogy (§1.2) — NOT for the classificatory reading of "constraint". That inference runs through STYLE: a style is a coordinated set of constraints, so dropping one yields a different style. Sigma is framed as a pattern and never uses "style", so the warrant does not transfer, and the classificatory claim it produces is unfalsifiable by construction. Alexander carries that load instead (alexander1979timeless). Removed from the abstract 2026-08-22.
            Third use, added 2026-08-22: ch. 6 ("Experience and Evaluation") as the model for a
            held-open §5.3. Fielding does not measure REST; he reports applying it to HTTP/1.1 and
            the URI standards and draws architectural lessons. That is the form §5.3 waits on from
            the reference implementation — what the pattern cost to build, where it bent, which
            variation points bore weight — and it is why the §1 claim boundary now disclaims
            measurement outright rather than pleading a partial implementation.},
}

@book{alexander1979timeless,
      title={The Timeless Way of Building},
      author={Alexander, Christopher},
      publisher={Oxford University Press},
      year={1979},
      note={Source of "forces" as the competing pressures a pattern resolves within a context — the vocabulary the software pattern literature later borrowed. Used in §1.4 for the domain forces, which pull against one another (visibility vs. awareness, attention vs. completeness) as distinct from the pattern's prescriptive constraints.
            Second and heavier use, added 2026-08-22: the warrant for why the six constraints are necessary. Alexander's pattern is a context, a system of forces, and a configuration in which those forces come to rest; a pattern has no arbitrary parts, because each element is present only at some force's demand. Validity is therefore functional and testable — a configuration missing a piece leaves a force in conflict — not definitional. This is the point the software reception mislaid: the GoF inheritance turned patterns into a catalog of reusable solutions, where Alexander's own claim is riskier, a conjecture about which arrangement lets a system of forces settle, refutable by exhibiting a force it fails to hold. That is exactly §1.6's falsifiability test, and it replaces the classificatory reading previously borrowed from Fielding (see fielding2000rest).},
}


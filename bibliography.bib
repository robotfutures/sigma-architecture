% ---------------------------------------------------------------
% Coherence — the term itself (§1.2, §3.7)
% ---------------------------------------------------------------

@book{beaugrande1981textlinguistics,
      title={Introduction to Text Linguistics},
      author={de Beaugrande, Robert-Alain and Dressler, Wolfgang Ulrich},
      publisher={Longman},
      address={London and New York},
      series={Longman Linguistics Library 26},
      year={1981},
      note={The source for §1.2's "linguistic sense". Coherence is the second of seven
            standards of textuality, defined as CONTINUITY OF SENSES — "the mutual access
            and relevance within a configuration of concepts and relations" underlying the
            surface text. Two borrowings. (1) The definition itself: coherence is a property
            of the configuration, not of any part, which is why §1.2 can hold three
            conditions at once and call the whole coherent or not. (2) Receiver-dependence:
            a text does not carry its sense, it is actualized by a receiver against their
            own stored knowledge — so coherence is not always achieved and not achieved
            identically by two readers. That is §1.2's "judged from a view, and views
            differ", and it is why "by whom" is a first-class concern rather than a caveat.
            Cited alongside Winograd and Flores, who supply the stronger claim (the
            background is unformalizable); de Beaugrande and Dressler supply the definition
            we are actually using. Frequently reprinted; the 1981 Longman edition is the
            one to cite.},
}

@book{halliday1976cohesion,
      title={Cohesion in English},
      author={Halliday, M. A. K. and Hasan, Ruqaiya},
      publisher={Longman},
      address={London},
      series={English Language Series 9},
      year={1976},
      note={The cohesion/coherence split, and the paper's sharpest available analogy for
            what a clean merge proves. Cohesion is surface connectivity — reference,
            ellipsis, substitution, conjunction, lexical cohesion — the grammatical ties
            between the actual words present. It is checkable on the text alone. Coherence
            is not, and cohesion neither guarantees nor is required for it: a passage can
            tie together perfectly and mean nothing consistent. This is exactly §3.7's
            figure — the three-way merge is a COHESION check (did these lines collide),
            offered as though it settled coherence. Cite where the paper says the merge is
            clean because no lines collided.},
}


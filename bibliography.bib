@misc{volkov2026statefusedeterministicconflictpreservingmemory,
      title={StateFuse: Deterministic Conflict-Preserving Memory for Multi-Agent Systems},
      author={Sergey Volkov and Yang Li and Ye Luo},
      year={2026},
      eprint={2607.05844},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2607.05844},
      note={Implemented + evaluated. OpSet CRDT (union merge, SEC intact) + an agent-facing contract: conflicts as first-class ConflictSet objects; resolution at projection time only, never mutating replicated state; decisions append-only but UNATTRIBUTED; no basis, no reader currency, no branch attribution. Vindicates the critique's direction (the CRDT side abandoning silent dissolution) without supplying the obligation layer. Key number: collapsed surfaces gave 40\% false-confident actions vs 0\% conflict-preserving — silent corruption manifests in ACTION, not QA accuracy (LWW wins raw QA on their slice; cite carefully). Place: CRDT paragraph (concession update), §5.3 boundary 2, §6 convergence},
}

@misc{wu2026gitcontextcontrollermanage,
      title={Git Context Controller: Manage the Context of LLM-based Agents like Git},
      author={Junde Wu and Minhao Hu and Jiayuan Zhu and Jiazhen Pan and Yuyuan Liu and Min Xu and Yueming Jin},
      year={2026},
      eprint={2508.00031},

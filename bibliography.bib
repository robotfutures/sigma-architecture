@misc{doors,
      title={IBM Engineering Requirements Management DOORS},
      author={{IBM}},
      howpublished={Software; product documentation},
      note={TODO cite product docs properly before submission.
            Source of the sharpest single mechanism in §1.5.2: the SUSPECT LINK. A traceability
            link is marked suspect when either end changes; the flag persists until a human
            re-examines the pair and clears it, and cleared flags are attributable. That is
            Sigma's debt (§3.8) and its discharge-by-attributed-act (constraint 5) at

      note={System paper, strong numbers (SWE-Bench Verified 80.2\%) — the one to distinguish by name. Versions ONE agent's private context (.GCC/ file tree; COMMIT/BRANCH/MERGE/CONTEXT verbs); "merge" is LLM synthesis — no ancestor, no basis, no conflict surfacing; "multi-agent" = sequential handoff, concurrency punted silently; no currency, no audiences, provenance as prose for the LLM, not machinery. The git METAPHOR for context compaction vs Sigma's git MECHANICS for shared truth. Place: §5.1 duct-tape exhibit (strongest — git vocabulary adopted wholesale), §4.2 (handoff without basis: the resumed agent inherits notes, not currency), §6 convergence},
}

@misc{li2026securityconsiderationsartificialintelligence,
      title={Security Considerations for Artificial Intelligence Agents},
      author={Ninghui Li and Kaiyuan Zhang and Kyle Polley and Jerry Ma},
      year={2026},
      eprint={2603.12230},
      archivePrefix={arXiv},
      primaryClass={cs.LG},
      url={https://arxiv.org/abs/2603.12230},
      note={Framework paper (Perplexity's NIST RFI response; no experiments). GIFTS: names the attribution gap unsolved (provenance contract fills it, §3.9); calls for a deterministic enforcement layer + complete mediation (the mount IS one, §3.4); lists exfiltration via "workspace files, memory entries" (§3.4 answers); names rubber-stamping (their risk-adaptive remedy = our blast-radius heuristic, §4.4); their stale-state-replay threat is structurally answered by basis-checked writes (§3.6); versioning/rollback absent from their framework entirely. PUNCHES to absorb: (1) mounted-but-poisoned — views bound reach, not rhetoric; injection inside a legitimate view is model-layer, don't overclaim §3.4; (2) delegation CHAINS (user-agent-subagent) may exceed a two-field principal/actor stamp; (3) per-mount policy manageability at scale — answer is templates/roles. Place: §3.4, §3.9, §4.4, §6 (fifth convergence pole: security)},
}

@misc{salemi2026llmbasedmultiagentblackboardinformation,
      title={LLM-Based Multi-Agent Blackboard System for Information Discovery in Data Science},
      author={Alireza Salemi and Mihir Parmar and Palash Goyal and Yiwen Song and Jinsung Yoon and Hamed Zamani and Tomas Pfister and Hamid Palangi},
      year={2026},
      eprint={2510.01285},
      archivePrefix={arXiv},
      primaryClass={cs.MA},
      url={https://arxiv.org/abs/2510.01285},
      note={Implemented + evaluated (UMass/Google; beats master-slave on 3 benchmarks). The revival is even LESS shared-artifact than Hearsay-II: board β carries only the main agent's help requests; helpers reply on a segregated board βᵣ they cannot see each other on — "to avoid dependencies where one sub-agent's output could influence the behavior of others negatively." Divergence prevented by ISOLATION, not turn-taking; no history, no versioning, no jointly-authored artifact; attribution unused. Contribution is capability routing, orthogonal to our point. Cite carefully in §1: coordination-by-isolation, and it strengthens the trends-toward-VCS claim (adds neither history nor lineage). Pairs with rodrigues2026: broadcast contaminates (+34\%), so they isolate entirely — the two naive poles; Sigma's gates/endorsement keep sharing without contamination},
}

@misc{shahid2026collaborativehumanagentprotocolchap,
      title={Collaborative Human-Agent Protocol (CHAP)},
      author={Arsalan Shahid and Gordon Suttie and Philip Black},
      year={2026},
      eprint={2606.09751},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2606.09751},
      note={Nearest neighbor — on the accountability axis. Industry protocol spec (Brightbeam AI, v0.2 draft, two reference impls, conformance harness). Event-sourced evidence log + task lifecycle + review/override through a central Coordinator. Claims our layer BY NAME ("neither MCP nor A2A defines the shared workspace in which humans and agents perform accountable work") then builds the audit half, not the state half: "merge/branch/fork/concurrent/stale" never appear; no scoped views, no currency, no principal/actor split; their named open problems (selective disclosure, parent-child workspaces) are our constraints 1-2 and fork topology. Machinery worth learning from: shadow/trial/production mode ladder (richer trust vocabulary than binary gates), typed abstention, intent_preserved flags, SCITT receipts (external verifiability — answers the substrate-trust punch from li2026security). Composable: CHAP over a Sigma substrate = audit layer over state layer. Pocket: CHAP audits the workflow around the work; Sigma versions the work itself. Place: distinguish-by-name in §5 alongside GCC; §4.4 gates; §6 convergence},
}

@misc{legit2026,
      title={Legit: A Git-based Version Control System for AI Agents},
      author={Nils Jacobsen and Martin Lysk and Jannes Blobel},
      year={2026},
      howpublished={Software, Legit-Control monorepo (Apache-2.0); npm @legit-sdk/core},
      url={https://github.com/Legit-Control/monorepo},
      note={Startup pole of the convergence (3-person team, ~17k LOC TS, real but early). Virtual FS over embedded git; every write a commit; full .legit/ control-file grammar (mkdir = branch, write SHA to .legit/head = rollback) — independent validation of verbs-as-file-writes (#1217, §3.2). Standout mechanism: DUAL-PARENT OPERATION COMMITS — agent intent recorded as a commit whose second parent is the content state it acted against; a basis pointer in vanilla git plumbing. Their own framing names constraint 5: "Git is blind to reads... coordination requires knowing what was read, in which state, under what assumptions" — claimed as differentiator, NOT implemented (no read tracking, no boundaries, no adjudication; hub aspirational). Scored: ~3 of 6 constraints as stated goals, ~1.5 shipped. Cite: §6 convergence; the blind-to-reads line as external articulation of reader currency's necessity},
}

@misc{joshi2026deonticpoliciesruntimegovernance,
      title={Deontic Policies for Runtime Governance of Agentic AI Systems},
      author={Anupam Joshi and Tim Finin and Karuna Pande Joshi and Lalana Kagal},
      year={2026},
      eprint={2606.19464},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2606.19464},
      note={The theory pole — AgenticRei: Kagal's Rei re-aimed at LLM agents (IEEE Agentic Services 2026; RDFox prototype, <10ms; eval thin). Four modalities: permission, prohibition, obligation (fires BECAUSE an action was permitted — our gate-after exactly), dispensation, + governable meta-policies. Their P3 is structurally our pre-push gate (prohibition lifted by credentialed permission). VOCABULARY GIFTS: "dispensation" names our silent-observe policy (a standing excusal from acknowledgment); governable meta-policies name who-may-change-write-policy. THEIR ADMITTED GAPS ARE OUR SHIPPED MACHINERY: obligation discharge is behaviorally monitored (deadline callbacks, trusted agents) — no per-actor ledger, no structural check; obligations bind only the actor ("every reader owes acknowledgment" has no Rei expression); enforcement object is an action triple, never an artifact/diff. Synthesis: AgenticRei is the policy calculus without the enforcement object; Sigma is the enforcement object without the policy calculus — they compose. Also: UMBC/MIT authors = candidate reviewers/collaborators for the arXiv push. Place: §4.4 (gates formalized), annex A.7, §6},
}

@misc{sure2026agl1enterpriseaigovernance,
      title={AGL-1: The Enterprise AI Governance Layer as a Control Plane for Trusted Enterprise Intelligence},
      author={Roopam W. Sure},
      year={2026},
      eprint={2607.03516},
      archivePrefix={arXiv},
      primaryClass={cs.SE},
      url={https://arxiv.org/abs/2607.03516},
      note={Solo-authored independent technical report (no implementation, no evaluation; references mostly vendor docs) — cite as problem framing only, and lightly. Governs the inference/action path at gateway seams: per-tool-call interception, "before/during/after execution" policy placement — but policy sees an INTENT, not a changeset: no diff, no basis, no artifact at the enforcement point, and post-execution is evidence-only (no debt, no acknowledgment obligation). Risk tiers attach to assets, not writers; approval is an evidence field, not a designed interaction; rubber-stamping unaddressed. Validates: trust as "a property of the system around the model"; authorization "at the retrieval, memory, tool, and agent-action layers." Useful vocabulary: failure taxonomy separating system failures from model failures (stale grounding, unmanaged memory, weak provenance — the constraints again); evidence-artifact catalog. Pairs with li2026security as the demand side: governance keeps specifying gate positions with nothing diff-shaped standing at them — the write boundary supplies the missing object},
}


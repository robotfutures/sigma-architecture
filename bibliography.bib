@article{grinter2003recomposition,
      title={Recomposition: Coordinating a Web of Software Dependencies},
      author={Grinter, Rebecca E.},
      journal={Computer Supported Cooperative Work (CSCW)},
      volume={12},
      pages={297--327},
      year={2003},
      note={Verified against PDF 2026-07-27. Ethnography (PARC; Tool/Comms/Computer Corp).
            Recomposition = "the work necessary to ensure that a software product can be
            assembled from its component pieces"; concept coined Grinter 1998. Key moves:
            Parnas promised decomposition would reduce communication; the field kept the
            technical half and lost the division-of-labor half. Dependencies arise four ways
            (designed-in, incomplete decomposability, legacy, requirements drift) and EVOLVE,
            so "decomposition may occur once... recomposition occurs throughout." CM tools
            "ameliorate some" needs but don't scale across subsystems — people fill the gap
            with informal roles. Position paper: the recomposability summand; also prior art
            for "the substrate ships bare, upper layers absorb the load".},
}


@misc{he2026replicatingbeliefbitsepistemic,
      title={Replicating Belief, Not Bits: Epistemic State Replication for Agentic Systems},
      author={He, Jun and Yu, Deying},
      year={2026},
      eprint={2607.09748},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2607.09748},
      note={Deep-read 2026-07-16 (subagent). Closest epistemic sibling: same diagnosis
            (bits != belief; CRDTs "lack semantic awareness"; conflicts surface explicitly
            with causal metadata), inverted prescription (verifier-mediated convergence of
            same-role replicas to an epsilon-ball vs. Sigma's attributed non-convergence
            across audiences). Mechanics: K=(L,B) evidence log (Raft-replicated) + belief
            lineage DAG; beliefs (phi, J, tau) with justification sets; semantic
            linearizability + bounded eventual coherence via contractive graft — an
            assumption the authors themselves flag as "strong." Cite in: 5.3.2 (MANDATORY —
            prior art for the CRDT semantic-blindness critique); basis 3.6 (justification
            sets = belief-grained provenance, but staleness is fault class f_stale, healed
            not refused: lineage present, transaction absent at the belief grain); consensus
            5.3.3 (semantic quorum = consensus over meaning projections; sharpens
            concurrence boundary); one-liners for currency 3.8 (fair-delivery assumption,
            no ledger) and N=1 4.2 (replicated-N=1: many copies, one mind). Annex A.5.
            CAUTION: v1 industry preprint (OpenKedge.io), un-peer-reviewed, self-cites own
            manifesto; ALL numbers (4.8x CTPS, ~97.7 percent secondary-fault reduction) from
            ONE unarchived illustrative trace — authors say not experimental validation;
            never cite figures without that caveat. No AGM or VCS engagement despite
            belief-revision and git-shaped machinery.},
}


}

@misc{joshi2026deonticpoliciesruntimegovernance,
      title={Deontic Policies for Runtime Governance of Agentic AI Systems},
      author={Anupam Joshi and Tim Finin and Karuna Pande Joshi and Lalana Kagal},
      year={2026},
      eprint={2606.19464},
      archivePrefix={arXiv},
      primaryClass={cs.AI},
      url={https://arxiv.org/abs/2606.19464},
      note={The theory pole — AgenticRei: Kagal's Rei re-aimed at LLM agents (IEEE Agentic Services 2026; RDFox prototype, <10ms; eval thin). Four modalities: permission, prohibition, obligation (fires BECAUSE an action was permitted — our gate-after exactly), dispensation, + governable meta-policies. Their P3 is structurally our pre-push gate (prohibition lifted by credentialed permission). VOCABULARY GIFTS: "dispensation" names our silent-observe policy (a standing excusal from acknowledgment); governable meta-policies name who-may-change-write-policy. THEIR ADMITTED GAPS ARE OUR SHIPPED MACHINERY: obligation discharge is behaviorally monitored (deadline callbacks, trusted agents) — no per-actor ledger, no structural check; obligations bind only the actor ("every reader owes acknowledgment" has no Rei expression); enforcement object is an action triple, never an artifact/diff. Synthesis: AgenticRei is the policy calculus without the enforcement object; Sigma is the enforcement object without the policy calculus — they compose. Also: UMBC/MIT authors = candidate reviewers/collaborators for the arXiv push. Place: §4.4 (gates formalized), annex A.7, §6},
}

